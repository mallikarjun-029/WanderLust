<% layout("layouts/boilerplate") %>

 <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>Add your listing :</h3>

    <form method="POST" action="/listings" class="needs-validation"  enctype="multipart/form-data" novalidate>
    
        <div class="mt-3 mb-3" >
            <label for="title" class="form-label">Title :</label>
            <input type="text" name="listing[title]"  placeholder="Enter Title" class="form-control" required>
            <div class="valid-feedback">Title is good</div>
        </div>
         <div class="mb-3">
            <label for="description"  class="form-label">Description :</label>
            <textarea type="text" name="listing[description]" class="form-control" placeholder="write about the place"></textarea>
        </div>
        <div class="mb-3">
            <label for="url"  class="form-label">Url :</label>
            <input type="file" name="listing[image]"  placeholder="url"  class="form-control" >
        </div>
        <div class="mb-3">
            <label for="category"  class="form-label">Category :</label>
            <input type="text" name="listing[category]"  placeholder="Ex: Mountains,Beach,Rooms,Camping,Farm,Iconic Cities,Castel,Pools,Arctic,"  class="form-control" >
        </div>


        <div class="row">
        <div class="mb-3 col-4">
            <label for="price"  class="form-label">Price :</label>
            <input type="text" name="listing[price]"  placeholder="&#8377;1200" class="form-control" required>
            <div class="valid-feedback">Enter valid price</div>
        </div>
        <div class="mb-3 col-8">
            <label for="country" class="form-label">Country :</label>
            <input type="text" name="listing[country]"   placeholder="India"  class="form-control" required>
            <div class="valid-feedback">valid Country</div>
        </div>
        </div>

        <div class="mb-3" >
            <label for="location" class="form-label">Location :</label>
            <input type="text" name="listing[location]" placeholder="Ex:Kanchi,Raipur..."  class="form-control" required>
            <div class="valid-feedback"></div>
        </div>
         
    <button type="submit" class="btn btn-dark mb-3 add-btn">Add</button>
    </form>

    </div>
    
</div>
